.relative
    .rs-fullscr-container
        #rs-fullwidth.tp-banner.dark-bg
            ul
                // SLIDE 1 — primary hero + CTAs
                li(data-transition='zoomout', data-slotamount='1', data-masterspeed='1500', data-saveperformance='on')
                    img(src='images/1.jpg', alt='', data-bgposition='center top', data-bgfit='cover', data-bgrepeat='no-repeat')
                    .rs-parallaxlevel-4.opacity-scroll2
                        .tp-caption.font-white.cg-rs-line.sfb.tp-resizeme(data-x='center', data-hoffset='0', data-y='center', data-voffset='-70', data-speed='500', data-start='850', data-easing='Power1.easeInOut', data-splitin='none', data-splitout='none', data-elementdelay='0.1', data-endelementdelay='0.1', style='z-index: 7; white-space: nowrap;')
                            span Reduce AWS Costs
                        .tp-caption.font-white.cg-rs-line.sfb.tp-resizeme(data-x='center', data-y='center', data-voffset='0', data-speed='500', data-start='1050', data-easing='Power1.easeInOut', data-splitin='none', data-splitout='none', data-elementdelay='0.1', data-endelementdelay='0.1', style='z-index: 8; white-space: nowrap;')
                            span.bold Fix Backend Performance
                        .tp-caption.font-white.cg-rs-cta.sfb.tp-resizeme(data-x='center', data-y='center', data-voffset='90', data-speed='500', data-start='1250', data-easing='Power1.easeInOut', data-splitin='none', data-splitout='none', data-elementdelay='0.1', data-endelementdelay='0.1', style='z-index: 9; white-space: nowrap;')
                            .hero-cta-buttons
                                a.btn.btn-lg.btn-color(href='#quote-request') Request a systems review
                                a.btn.btn-lg.btn-white-outline(href='#quote-request') Get a cost &amp; performance audit
                // SLIDE 2
                li(data-transition='zoomout', data-slotamount='1', data-masterspeed='1500', data-saveperformance='on')
