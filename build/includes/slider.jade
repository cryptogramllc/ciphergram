.relative
    .rs-fullscr-container
        #rs-fullwidth.tp-banner.dark-bg
            ul
                // SLIDE 1 — primary hero
                li(data-transition='zoomout', data-slotamount='1', data-masterspeed='1500', data-saveperformance='on')
                    img(src='images/1.jpg', alt='', data-bgposition='center top', data-bgfit='cover', data-bgrepeat='no-repeat')
                    .rs-parallaxlevel-4.opacity-scroll2
                        .tp-caption.font-white.light-60-wide.sfb.tp-resizeme(data-x='center', data-hoffset='0', data-y='center', data-voffset='-95', data-speed='500', data-start='850', data-easing='Power1.easeInOut', data-splitin='none', data-splitout='none', data-elementdelay='0.1', data-endelementdelay='0.1', style='z-index: 7; max-width: 900px; max-height: auto; white-space: normal; text-align: center; line-height: 1.2;')
                            span Reduce AWS costs and fix backend performance issues in scaling SaaS systems.
                        .tp-caption.font-white.light-40-wide.sfb.tp-resizeme(data-x='center', data-y='center', data-voffset='25', data-speed='500', data-start='1000', data-easing='Power1.easeInOut', data-splitin='none', data-splitout='none', data-elementdelay='0.1', data-endelementdelay='0.1', style='z-index: 8; max-width: 760px; max-height: auto; white-space: normal; text-align: center; line-height: 1.45;')
                            span We help engineering teams optimize, modernize, and stabilize backend infrastructure using Go, AWS Lambda, and serverless architecture.
                        .tp-caption.font-white.light-40-wide.sfb.tp-resizeme(data-x='center', data-y='center', data-voffset='120', data-speed='500', data-start='1250', data-easing='Power1.easeInOut', data-splitin='none', data-splitout='none', data-elementdelay='0.1', data-endelementdelay='0.1', style='z-index: 9; max-width: auto; max-height: auto; white-space: nowrap;')
                            .hero-cta-buttons
                                a.btn.btn-lg.btn-color.mr-15(href='#quote-request') Request a systems review
                                a.btn.btn-lg.btn-white(href='#quote-request') Get a cost &amp; performance audit
