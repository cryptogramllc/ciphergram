section.cg-hero#home-hero
    .cg-hero-bg(style="background-image: url(images/1.jpg);")
    .cg-hero-overlay
    .cg-hero-inner
        .container
            .cg-hero-content
                p.cg-hero-eyebrow Backend systems consultancy
                h1.cg-hero-title Reduce AWS costs and fix backend performance issues in scaling SaaS systems.
                p.cg-hero-sub We help engineering teams optimize, modernize, and stabilize backend infrastructure using Go, AWS Lambda, and serverless architecture.
                .cg-hero-actions
                    a.btn.btn-lg.btn-color(href='#quote-request') Request a systems review
                    a.btn.btn-lg.btn-white-outline(href='#quote-request') Get a cost &amp; performance audit
