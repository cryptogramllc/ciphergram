include ./includes/head.jade
body
    // LOADER
    #loader-overflow
        #loader3 Please enable JS
    #wrap.boxed
        .grey-bg
            // Grey BG
            //if lte IE 8
                #ie-container
                    #ie-cont-close
                        a(href='#', onclick='javascript:this.parentNode.parentNode.style.display="none"; return false;')
                            img(src='images/ie-warn/ie-warning-close.jpg', style='border: none;', alt='Close')
                    #ie-cont-content
                        #ie-cont-warning
                            img(src='images/ie-warn/ie-warning.jpg', alt='Warning!')
                        #ie-cont-text
                            #ie-text-bold
                            #ie-text
                        #ie-cont-brows
                            a(href='http://www.firefox.com', target='_blank')
                                img(src='images/ie-warn/ie-warning-firefox.jpg', alt='Download Firefox')
                            a(href='http://www.opera.com/download/', target='_blank')
                                img(src='images/ie-warn/ie-warning-opera.jpg', alt='Download Opera')
                            a(href='http://www.apple.com/safari/download/', target='_blank')
                                img(src='images/ie-warn/ie-warning-safari.jpg', alt='Download Safari')
                            a(href='http://www.google.com/chrome', target='_blank')
                                img(src='images/ie-warn/ie-warning-chrome.jpg', alt='Download Google Chrome')
            include ./includes/header.jade
            include ./includes/slider.jade
            include ./includes/problem.jade
            include ./includes/services.jade
            include ./includes/ai.jade
            include ./includes/who-for.jade
            include ./includes/outcomes.jade
            include ./includes/clients.jade
            include ./includes/about.jade

            section.page-section.cg-cta-band
                .container
                    .row
                        .col-md-8.col-md-offset-2.text-center
                            h3.cg-cta-title When cost, latency, or AI in production breaks, you need systems engineers—not a generic AI demo shop
                            p.cg-cta-sub Tell us about your stack, AWS footprint, AI usage, and what production is doing under load. We respond with a scoped review or audit plan.
                            .cg-hero-actions
                                a.btn.btn-lg.btn-color(href='#quote-request') Request a backend systems review
                                a.btn.btn-lg.btn-white-outline(href='#quote-request') Talk about AI integration

            include ./includes/pricing.jade

            .page-section.p-120-cont.cg-section.clearfix
                .container
                    .row
                        .col-md-10.col-md-offset-1.text-center.mb-60
                            h2.cg-section-title Frequently asked questions
                    .row
                        .col-md-6
                            .cg-faq-item.wow.fadeIn.mb-30
                                h3 What does Ciphergram do?
                                p Ciphergram is a specialist backend systems consultancy. We help SaaS companies reduce AWS costs, improve backend performance, modernize with serverless architecture, and integrate AI into existing production systems—using Go, AWS Lambda, and AI-assisted engineering.
                        .col-md-6
                            .cg-faq-item.wow.fadeIn.mb-30
                                h3 How do you use AI in your work?
                                p Two ways. First, AI-assisted delivery: we use AI to accelerate codebase analysis, scaffolding, and migration diffs while senior engineers own architecture, review, and production risk. Second, AI systems integration: we wire LLMs and inference into your existing AWS backends with cost, latency, and reliability controls.
                    .row
                        .col-md-6
                            .cg-faq-item.wow.fadeIn.mb-30
                                h3 Who do you work best with?
                                p SaaS teams scaling past MVP, engineering organizations with rising AWS or AI bills, startups seeing production performance issues, and CTOs adding production AI to legacy or serverless backends.
                        .col-md-6
                            .cg-faq-item.wow.fadeIn.mb-30
                                h3 What is an AWS cost optimization audit?
                                p A fixed-scope review of how your AWS bill maps to workloads: Lambda, API Gateway, compute, networking, storage, and AI/inference spend when in scope. You get a prioritized list of changes with expected savings and risk notes.
                    .row
                        .col-md-6.col-md-offset-3
                            .cg-faq-item.wow.fadeIn.mb-30
                                h3 How do engagements begin?
                                p Most teams start with a backend systems review or a cost and performance audit. We clarify scope, access needs, AI usage, and success metrics before work starts.

            section#quote-request.page-section.p-120-cont.cg-section.grey-light-bg
                .container
                    .row
                        .col-md-8.col-md-offset-2.text-center
                            h3.cg-section-title Request a backend systems review
                            p.cg-section-lead Share your stack, symptoms, AWS context, and any AI features in flight. We reply with next steps for a cost analysis, performance audit, serverless migration, or AI integration assessment—usually within one business day.
                            .quote-form-container
                                form#quoteForm.quote-form
                                    .row
                                        .col-md-6
                                            .form-group
                                                input.form-control(type='text', name='name', placeholder='Name *', required)
                                        .col-md-6
                                            .form-group
                                                input.form-control(type='email', name='email', placeholder='Work email *', required)
                                    .row
                                        .col-md-6
                                            .form-group
                                                input.form-control(type='text', name='company', placeholder='Company')
                                        .col-md-6
                                            .form-group
                                                input.form-control(type='text', name='role', placeholder='Role (e.g. CTO, VP Eng, Lead)')
                                    .row
                                        .col-md-6
                                            .form-group
                                                select.form-control(name='project_type', required)
                                                    option(value='') Primary need *
                                                    option(value='aws-cost') AWS cost optimization audit
                                                    option(value='performance') Backend performance engineering
                                                    option(value='serverless') Serverless migration
                                                    option(value='ai-integration') AI systems integration
                                                    option(value='combined') Combined / not sure yet
                                        .col-md-6
                                            .form-group
                                                select.form-control(name='timeline')
                                                    option(value='') Target start window
                                                    option(value='asap') ASAP
                                                    option(value='2-4w') 2–4 weeks
                                                    option(value='1-2m') 1–2 months
                                                    option(value='flex') Flexible
                                    .row
                                        .col-md-12
                                            .form-group
                                                select.form-control(name='aws_scale')
                                                    option(value='') Approx. monthly AWS spend (optional)
                                                    option(value='under-5k') Under $5k
                                                    option(value='5k-25k') $5k–$25k
                                                    option(value='25k-100k') $25k–$100k
                                                    option(value='100k-plus') $100k+
                                                    option(value='unsure') Prefer not to say / unsure
                                    .form-group
                                        textarea.form-control(name='project_description', rows='5', placeholder='Describe your architecture (languages, AWS services, AI/LLM usage), what broke or is trending wrong (cost, latency, errors), and what good looks like. *', required)
                                    .form-group
                                        textarea.form-control(name='additional_info', rows='3', placeholder='Links to dashboards, postmortems, or constraints (compliance, multi-region, model providers, etc.)')
                                    .text-center
                                        button.btn.btn-lg.btn-color(type='submit') Submit review request
                                        p.quote-note
                                            | No spam. We may ask one clarifying round by email before proposing scope.

            include ./includes/contact.jade
            include ./includes/footer.jade
            p#back-top
                a(href='#top', title='Back to Top')
                    span.icon.icon-arrows-up
    #clientModal.client-modal
        .client-modal-content
            span.client-modal-close ×
            .client-modal-header
                img#clientModalLogo(src="", alt="Client Logo", class="client-modal-logo")
                h2#clientModalTitle.client-modal-title
            .client-modal-body
                p#clientModalDescription.client-modal-description
                .client-modal-tech
                    h4 Technologies Used:
                    #clientModalTech.tech-tags
    .mfp-more-info
        strong
            i i
    .mfp-text
        .mfp-text-inner
        .mfp-text-close 
            button(title="Close (Esc)", type="button", class="mfp-text-close-button") ×

include ./includes/scripts/js.jade
